# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Supabase connection pooler or direct connection)
# Example: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:your-db-password@db.supabase.co:5432/postgres

# Supabase Authentication & Project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Telegram Bot Integration API Key (used to authenticate requests from the Telegram bot)
TELEGRAM_BOT_API_KEY=gebere-bot-secret-api-key
